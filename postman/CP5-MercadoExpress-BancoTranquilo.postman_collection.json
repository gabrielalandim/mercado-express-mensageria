{
  "info": {
    "name": "CP5 - Mercado Express + Banco Tranquilo (RabbitMQ)",
    "description": "Testes da integração Mercado Express <-> Banco Tranquilo via RabbitMQ. Rode a pasta 'Mercado Express (Loja)' em ordem (Collection Runner com delay de 2000 ms).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Mercado Express (Loja) - :8081",
      "item": [
        {
          "name": "01 - Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{loja}}/api/produtos",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"Há produtos cadastrados\", () => pm.expect(p.length).to.be.above(0));",
                  "pm.collectionVariables.set(\"produtoId\", p[0].id);",
                  "pm.collectionVariables.set(\"produtoId2\", p[Math.min(1, p.length - 1)].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Compra APROVADA (conta 1001-0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{loja}}/api/compras",
            "description": "Cria a compra e publica a solicitação em banco.tranquilo.pagamentos.exchange. Aguarde ~2s e rode a requisição 03.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteNome\": \"Maria Gabriela Landim Severo\",\n  \"clienteEmail\": \"gabi@email.com\",\n  \"clienteCpf\": \"111.111.111-11\",\n  \"numeroConta\": \"1001-0\",\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 2\n    },\n    {\n      \"produtoId\": {{produtoId2}},\n      \"quantidade\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 202\", () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "pm.test(\"Pedido aguardando o Banco Tranquilo\", () => pm.expect(b.status).to.eql(\"AGUARDANDO_PAGAMENTO\"));",
                  "pm.collectionVariables.set(\"pedidoId\", b.id);"
                ]
              }
            }
          ]
        },
