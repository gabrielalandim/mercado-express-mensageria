        {
          "name": "05 - Publicar solicitação manual no exchange do banco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbit}}/api/exchanges/%2F/banco.tranquilo.pagamentos.exchange/publish",
            "description": "Simula a Loja: publica uma solicitação direto no exchange. Como o pedido já foi processado, o banco reenvia o mesmo resultado (idempotência).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"content_type\": \"application/json\",\n    \"correlation_id\": \"teste-manual\"\n  },\n  \"routing_key\": \"pagamento.solicitado\",\n  \"payload\": \"{\\\"pedidoId\\\": {{pedidoId}}, \\\"numeroConta\\\": \\\"1001-0\\\", \\\"cpf\\\": \\\"11111111111\\\", \\\"nomeCliente\\\": \\\"Maria Gabriela Landim Severo\\\", \\\"emailCliente\\\": \\\"gabi@email.com\\\", \\\"valor\\\": 10.0, \\\"descricao\\\": \\\"Publicado manualmente via Management API\\\"}\",\n  \"payload_encoding\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mensagem roteada\", () => pm.expect(pm.response.json().routed).to.eql(true));"
                ]
              }
            }
          ]
        },
